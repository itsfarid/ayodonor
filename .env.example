# GEMINI_API_KEY: Required for Gemini AI API calls. Without it the app runs, and AI features
# answer with clearly labelled local fallbacks. Never commit a real value.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# --- Server runtime (all optional) ---
# NODE_ENV: "production" serves the built app from dist/public. Anything else starts the Vite dev
#   server. The production bundle (npm run build) is pinned to production regardless of this value.
# PORT: listen port (default 3000). Cloud platforms usually inject it.
# HOST: bind address (default 0.0.0.0 in production, 127.0.0.1 in development).
# TRUST_PROXY: number of reverse-proxy hops in front of the app (default 0 = none). Rate limiting
#   identifies clients by IP; behind a proxy set this to the real hop count (e.g. 1) or all users
#   share one bucket. Never use "true": it lets clients spoof their IP.
# GEMINI_TIMEOUT_MS: deadline for one Gemini call, 1000-120000 (default 20000).
# STATIC_DIR: override the built frontend directory (default dist/public).
