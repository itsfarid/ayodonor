# Cloudflare Pages response headers (static hosting). Deliberately no Content-Security-Policy yet:
# see docs/static-deployment.md for the recommended CSP, which must be tested in a browser first.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()

# Vite emits content-hashed file names under /assets/, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
