# Cloudflare Pages response headers (static hosting). Deliberately no Content-Security-Policy yet:
# see docs/static-deployment.md for the recommended CSP, which must be tested in a browser first.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()

# Vite emits content-hashed file names under /assets/, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# /404 is the address the static-assets router gives to dist/404.html, and it answers 200 (unknown addresses answer 404).
# The page already carries <meta name="robots" content="noindex">; this header says the same without needing the HTML.
/404
  X-Robots-Tag: noindex
/404.html
  X-Robots-Tag: noindex
